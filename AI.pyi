"""AI.py 的渐进类型存根（仅覆盖最常用的公开 API）。

完整覆盖 90k 行单文件不现实；这里给出外部调用最常碰到的类/函数签名，
配合 ``py.typed`` 与 ``mypy.ini`` 做渐进类型检查。未列出的名字按 Any 处理。
"""

from typing import Any, Callable, Dict, List, Optional, Sequence, Tuple, Union

Number = Union[int, float]
Vector = List[float]
Matrix = List[List[float]]


class Layer:
    weights: Matrix
    biases: Vector
    fan_in: int
    fan_out: int
    activation_name: str
    def __init__(self, fan_in: int, fan_out: int, activation: str = ...,
                 is_output: bool = ...) -> None: ...
    def forward(self, x: Sequence[Number]) -> Vector: ...
    def backward(self, delta: Sequence[Number]) -> Tuple[Matrix, Vector, List[float]]: ...


class MLP:
    layers: List[Layer]
    def __init__(self, layer_sizes: Sequence[int],
                 activations: Optional[Sequence[str]] = ...) -> None: ...
    def forward(self, x: Sequence[Number]) -> List[float]: ...
    def param_count(self) -> int: ...
    def save(self, path: str) -> None: ...


class Model:
    model: MLP
    def __init__(self, model: MLP, loss_fn: str = ..., optimizer: str = ...,
                 lr: float = ..., task: Optional[str] = ...) -> None: ...
    def fit(self, x: Optional[Any] = ..., y: Optional[Any] = ...,
            data: Optional[Any] = ..., epochs: int = ..., batch_size: int = ...,
            val_split: float = ..., val_data: Optional[Any] = ...,
            patience: int = ..., verbose: bool = ..., shuffle: bool = ...,
            lr_scheduler: Optional[Any] = ..., grad_clip: Optional[float] = ...,
            early_stop_metric: str = ..., restore_best_weights: bool = ...,
            checkpoint_path: Optional[str] = ...,
            checkpoint_every: int = ..., grad_accum: int = ...,
            seed: Optional[int] = ..., callbacks: Optional[Any] = ...,
            resume_from: Optional[str] = ..., mixup_alpha: float = ...,
            record_layer_norms: bool = ..., adv_eps: float = ...,
            adv_steps: int = ..., adv_alpha: Optional[float] = ...,
            train_augment: Optional[Any] = ...) -> Dict[str, Any]: ...
    def predict(self, x: Sequence[Sequence[Number]]) -> List[Any]: ...
    def evaluate(self, x: Sequence[Sequence[Number]],
                 y: Sequence[Any]) -> Dict[str, float]: ...


class Callback:
    def on_train_begin(self, model: Any, info: Dict[str, Any]) -> None: ...
    def on_epoch_begin(self, epoch: int, info: Dict[str, Any]) -> None: ...
    def on_epoch_end(self, epoch: int, logs: Dict[str, Any]) -> None: ...
    def on_train_end(self, history: Any) -> None: ...


class CheckpointManager:
    directory: str
    metric: str
    def __init__(self, directory: str, metric: str = ..., mode: str = ...,
                 keep_last: int = ..., keep_best: int = ...,
                 name: str = ...) -> None: ...
    def save(self, model: Any, epoch: int,
             metrics: Optional[Dict[str, Number]] = ...) -> str: ...
    def prune(self) -> List[str]: ...
    def best(self, k: int = ...) -> List[Dict[str, Any]]: ...
    def resume(self) -> Optional[Dict[str, Any]]: ...
    def load_best(self, k: int = ...) -> Tuple[Optional[Any], Optional[Dict[str, Any]]]: ...


class CheckpointCallback(Callback):
    def __init__(self, manager: CheckpointManager,
                 start_epoch: int = ...) -> None: ...


class ExperimentTracker:
    path: Optional[str]
    def __init__(self, directory: str, name: str = ...,
                 config: Optional[Dict[str, Any]] = ...,
                 clock: Optional[Callable[[], float]] = ...,
                 extra: Optional[Dict[str, Any]] = ...) -> None: ...
    def start(self) -> "ExperimentTracker": ...
    def log_metrics(self, mapping: Dict[str, Number]) -> None: ...
    def log_curve(self, name: str, values: Sequence[Number]) -> None: ...
    def finish(self, status: str = ..., error: Optional[str] = ...) -> str: ...


def load_config(path: str) -> Dict[str, Any]: ...
def parse_config_text(text: str, fmt: str = ..., source: Optional[str] = ...) -> Dict[str, Any]: ...
def save_model(model: MLP, filepath: str, task: Optional[str] = ...,
               optimizer: Optional[Any] = ..., **kwargs: Any) -> str: ...
def load_model(filepath: str,
               default_output_activation: Optional[str] = ...) -> MLP: ...
def export_onnx_mlp(model: MLP, path: Optional[str] = ...) -> bytes: ...
def profile_model(model: Any, x: Sequence[Number], backward: bool = ...,
                  repeat: int = ...) -> Dict[str, Any]: ...
class track_memory:
    stats: Dict[str, Any]
    def __init__(self, label: Optional[str] = ...) -> None: ...
def memory_usage() -> Dict[str, Any]: ...
def model_metadata(model: Any, config: Optional[Dict[str, Any]] = ...,
                   metrics: Optional[Dict[str, Any]] = ...,
                   extra: Optional[Dict[str, Any]] = ...,
                   directory: Optional[str] = ...) -> Dict[str, Any]: ...
def set_seed(seed: int) -> None: ...
def cross_entropy_loss(logits: Sequence[Number],
                       target: int) -> float: ...
def mse_loss(pred: Sequence[Number], target: Sequence[Number]) -> float: ...
def accuracy(pred: Sequence[Any], target: Sequence[Any]) -> float: ...
def gumbel_softmax(logits: Sequence[Number], temperature: float = ...,
                   hard: bool = ..., seed: Optional[int] = ...) -> List[float]: ...
def sparsemax(logits: Sequence[Number]) -> List[float]: ...
def entmax(logits: Sequence[Number], alpha: float = ...) -> List[float]: ...
def safetensors_save(tensors: Dict[str, Any], path: str) -> str: ...
def safetensors_load(path: str) -> Dict[str, Any]: ...
